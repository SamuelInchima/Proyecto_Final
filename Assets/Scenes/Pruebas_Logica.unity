    m_PersistentCalls:
      m_Calls: []
  m_text: "EVALUACI\xD3N PSICOT\xC9CNICA Y DE COMPETENCIAS BANCARIAS - NEXOBANK\r\n\r\nBienvenido
    al m\xF3dulo de valoraci\xF3n de perfil laboral y habilidades del sector financiero.\r\n\r\n\xBFEN
    QU\xC9 CONSISTE ESTA PRUEBA?\r\nA continuaci\xF3n se presentar\xE1n 15 situaciones
    cotidianas de trabajo en una oficina bancaria (manejo de caja, trabajo bajo presi\xF3n,
    trato con clientes y conocimientos b\xE1sicos del \xE1rea).\r\n\r\nINSTRUCCIONES
    IMPORTANTES:\r\n\u2022 Sin l\xEDmite de tiempo: En este m\xF3dulo NO hay cron\xF3metro.
    Lee cada situaci\xF3n con total calma.\r\n\u2022 Sin p\xE9rdida de vidas: Aqu\xED
    NO existen respuestas buenas o malas que te hagan perder el juego.\r\n\u2022
    Responde con total sinceridad: No busques responder lo que crees que el banco
    quiere escuchar; elige la opci\xF3n que mejor refleje c\xF3mo actuar\xEDas realmente
    en tu d\xEDa a d\xEDa laboral.\r\n\r\nCuando est\xE9s listo para comenzar en
    un ambiente tranquilo, presiona el bot\xF3n inferior."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
